{
  "name": "@backend/ms_categories",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@backend/ms_categories:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@backend/ms_categories:build:development"
          },
          "production": {
            "buildTarget": "@backend/ms_categories:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "migration:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "typeorm-ts-node-commonjs migration:generate -d src/app/databases/ormconfig.ts src/app/databases/migrations/{args.name}",
          "cwd": "apps/ms_categories"
        }
      },
      "migration:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "typeorm-ts-node-commonjs migration:run -d src/app/databases/ormconfig.ts",
          "cwd": "apps/ms_categories"
        }
      },
      "migration:revert": {
        "executor": "nx:run-commands",
        "options": {
          "command": "typeorm-ts-node-commonjs migration:revert -d src/app/databases/ormconfig.ts",
          "cwd": "apps/ms_categories"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.16.3",
    "typeorm": "^0.3.25"
  }
}
